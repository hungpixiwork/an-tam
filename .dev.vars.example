# Chép thành .dev.vars cho `wrangler dev` (KHÔNG commit .dev.vars). Production: `wrangler secret put <TÊN>`.

# 32 byte ngẫu nhiên, base64 — mã hóa token tích hợp (AES-256-GCM).
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# Khóa HMAC cho chuỗi hash audit_log (chuỗi ngẫu nhiên dài)
AUDIT_HASH_SALT=

# Google OAuth (Calendar, Gmail, Sheets) — redirect: <APP_ORIGIN>/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notion public integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# SePay: API key xác thực webhook + API token Bank Hub
# Webhook: POST <APP_ORIGIN>/api/webhooks/sepay, SePay gửi header "Authorization: Apikey <SEPAY_WEBHOOK_KEY>".
# Trên SePay chọn "Xác thực: API Key" và dán cùng giá trị. Máy local: chuỗi bất kỳ (scripts/seed-demo.mjs đọc từ .dev.vars).
SEPAY_WEBHOOK_KEY=
SEPAY_API_TOKEN=
