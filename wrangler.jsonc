{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API và Assets do Worker xử lý, chặn SPA fallback nuốt nhầm assets không tồn tại
    "run_worker_first": ["/api/*", "/assets/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-tam-db",
      // D1 production (wrangler d1 create an-tam-db)
      "database_id": "2b46538a-ac46-4bf4-8ed2-93a8f33b0587",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Origin công khai cho redirect OAuth; để trống = lấy origin từ request
    "APP_ORIGIN": "",
    // Bộ phân loại ý định agent: "rules" (mặc định) | "workers-ai"
    "INTENT_PROVIDER": "rules"
  },
  // Secrets (wrangler secret put …, local: .dev.vars — xem .dev.vars.example):
  // TOKEN_ENC_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NOTION_CLIENT_ID, NOTION_CLIENT_SECRET,
  // SEPAY_WEBHOOK_KEY, SEPAY_API_TOKEN, AUDIT_HASH_SALT
  //
  // Wave sau thêm (cần ID thật / remote):
  // "ai": { "binding": "AI" },
  // "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "<wrangler kv namespace create OAUTH_KV>" }],
  // và run_worker_first thêm "/mcp", "/oauth/*", "/.well-known/*"
  "triggers": {
    "crons": [
      // 08:00 giờ Việt Nam — "AI theo dõi" chạy lại cảnh báo cho mọi người dùng
      "0 1 * * *",
      // Mỗi 15 phút — automation / đồng bộ / dọn dữ liệu hết hạn (worker/index.ts → scheduled)
      "*/15 * * * *"
    ]
  },
  "observability": { "enabled": true }
}
