{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API và Assets do Worker xử lý, chặn SPA fallback nuốt nhầm assets không tồn tại
    "run_worker_first": ["/api/*", "/agents/*", "/assets/*", "/mcp", "/authorize", "/token", "/register", "/.well-known/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-tam-db",
      // D1 production (wrangler d1 create an-tam-db)
      "database_id": "2b46538a-ac46-4bf4-8ed2-93a8f33b0587",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Origin công khai cho redirect OAuth; để trống = lấy origin từ request
    "APP_ORIGIN": "",
    // Bộ phân loại ý định agent: "rules" | "workers-ai" (hết lượt AI theo gói → tự dùng luật)
    "INTENT_PROVIDER": "workers-ai"
  },
  // Workers AI (Qwen3) — wrangler dev gọi AI thật trên tài khoản đã đăng nhập (lỗi / chưa login → agent dùng luật)
  "ai": { "binding": "AI", "remote": true },
  // KV cho MCP OAuth. Không ghi id: wrangler dev dùng KV cục bộ, wrangler deploy tự tạo namespace.
  // Nếu đã có namespace (wrangler kv namespace create OAUTH_KV) thì thêm "id": "<id>".
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Việc nền theo từng người dùng: cron chỉ đẩy lô userId, consumer (worker/index.ts → queue) xử lý.
  // Tạo trước khi deploy: wrangler queues create an-tam-jobs && wrangler queues create an-tam-jobs-dlq
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "an-tam-jobs" }],
    "consumers": [
      { "queue": "an-tam-jobs", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "an-tam-jobs-dlq" }
    ]
  },
  // Bàn đầu tư theo mã: mỗi bước là step.do (worker/desk/workflow.ts), id instance = desk-<MÃ>-<ngày>
  "workflows": [{ "name": "an-tam-desk", "binding": "DESK_WORKFLOW", "class_name": "DeskWorkflow" }],
  "durable_objects": {
    "bindings": [{ "name": "USER_COORDINATOR", "class_name": "UserCoordinatorAgent" }]
  },
  "migrations": [{ "tag": "user-coordinator-v1", "new_sqlite_classes": ["UserCoordinatorAgent"] }],
  // Workers Rate Limiting (namespace_id: số nguyên dạng chuỗi, duy nhất trong tài khoản; period chỉ 10 hoặc 60 giây)
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "2401", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_AI", "namespace_id": "2402", "simple": { "limit": 30, "period": 60 } }
  ],
  // Secrets (wrangler secret put …, local: .dev.vars — xem .dev.vars.example):
  // TOKEN_ENC_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, NOTION_CLIENT_ID, NOTION_CLIENT_SECRET,
  // SEPAY_WEBHOOK_KEY, SEPAY_API_TOKEN, AUDIT_HASH_SALT, PLAN_RECEIVER_BANK, PLAN_RECEIVER_ACCOUNT, PLAN_RECEIVER_NAME
  //
  "triggers": {
    "crons": [
      // 08:00 giờ Việt Nam — "AI theo dõi" chạy lại cảnh báo cho mọi người dùng
      "0 1 * * *",
      // Mỗi giờ (phút 05) — giá thị trường, automation / đồng bộ / dọn dữ liệu hết hạn (worker/index.ts → scheduled)
      "5 * * * *"
    ]
  },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
