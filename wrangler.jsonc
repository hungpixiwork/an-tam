{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "antam",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API do Worker xử lý, không để SPA fallback nuốt mất
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "an-tam-db",
      // D1 production (wrangler d1 create an-tam-db)
      "database_id": "2b46538a-ac46-4bf4-8ed2-93a8f33b0587",
      "migrations_dir": "migrations"
    }
  ],
  // 08:00 giờ Việt Nam — "AI theo dõi" chạy lại cảnh báo cho mọi người dùng
  "triggers": { "crons": ["0 1 * * *"] },
  "observability": { "enabled": true }
}
