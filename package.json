{
  "name": "an-tam-ai",
  "version": "1.0.0",
  "private": true,
  "description": "An Tâm AI - Hiểu tiền của bạn. Chuẩn bị cho tương lai.",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply an-tam-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply an-tam-db --remote",
    "db:seed": "wrangler d1 execute an-tam-db --local --file=./seeds/catalog.sql",
    "db:seed:remote": "wrangler d1 execute an-tam-db --remote --file=./seeds/catalog.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:engine": "vitest run tests/engine.test.ts",
    "test:analysis": "vitest run tests/analysis.test.ts",
    "test:narrate": "vitest run tests/narrate.test.ts",
    "test:ledger": "vitest run tests/ledger.test.ts",
    "test:format": "vitest run tests/format.test.ts",
    "test:chunk-recovery": "vitest run tests/chunk-recovery-regression.test.ts",
    "test:quick": "vitest run tests/narrate.test.ts tests/engine.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/node": "^26.6.4",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.138.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.1.0",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.24.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  }
}
